# LLM provider (GLM via Z.AI, OpenAI-compatible endpoint)
LLM_PROVIDER=glm
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/     # confirm exact endpoint when we build llm_client.py
GLM_MODEL=glm-4-flash

# Embeddings provider (Gemini)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

SUPABASE_DB_URL=postgresql://...pooler.supabase.com:6543/postgres
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.6