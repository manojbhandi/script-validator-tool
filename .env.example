# LLM provider (any OpenAI-compatible chat endpoint; tested with Gemini and Z.AI GLM)
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-3.6-flash
# Z.AI:    LLM_BASE_URL=https://api.z.ai/api/paas/v4/                             LLM_MODEL=glm-5.3-flash
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash

# Embeddings provider (Gemini)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Database (Supabase Postgres + pgvector, transaction pooler URI)
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
RETRIEVAL_TOP_K=8
SIMILARITY_THRESHOLD=0.68
